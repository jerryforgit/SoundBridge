#!/bin/bash
set -e

APP="/Applications/SoundBridge.app"
DRIVER="/Library/Audio/Plug-Ins/HAL/SoundBridge.driver"
BUNDLE_ID="com.jerry.soundbridge"

# Installer scripts run as root, and on some Macs /dev/console is owned by
# root even though a GUI user is logged in. Fall back to the ConsoleUser
# state, the Dock owner, then `who`.
console_user() {
    local u=""
    u=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)
    if [ -z "$u" ] || [ "$u" = "root" ]; then
        u=$(/usr/sbin/scutil <<< "show State:/Users/ConsoleUser" 2>/dev/null |
            /usr/bin/awk '/^[[:space:]]*Name[[:space:]]*:/ {print $3; exit}')
    fi
    if [ -z "$u" ] || [ "$u" = "root" ]; then
        u=$(/bin/ps -axo user=,comm= | /usr/bin/awk '$2 ~ /\/Dock$/ {print $1; exit}')
    fi
    if [ -z "$u" ] || [ "$u" = "root" ]; then
        u=$(/usr/bin/who | /usr/bin/awk '$2 == "console" {print $1; exit}')
    fi
    printf '%s' "$u"
}

CONSOLE_USER=$(console_user)
CONSOLE_UID=""
USER_HOME=""
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    CONSOLE_UID=$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || true)
    USER_HOME=$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null |
        /usr/bin/awk '{print $2}')
fi

# Quit the app.
/usr/bin/pkill -x SoundBridge 2>/dev/null || true
/bin/sleep 0.5

# Older builds registered an SMAppService login item. Unregister it while the
# app bundle still exists (requires the matching binary).
if [ -d "$APP" ] && [ -n "$CONSOLE_UID" ]; then
    /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" \
        "$APP/Contents/MacOS/SoundBridge" --unregister-login 2>/dev/null || true
    /bin/sleep 0.3
fi

# Current builds use a LaunchAgent. Unload and delete it.
if [ -n "$CONSOLE_UID" ]; then
    /bin/launchctl bootout "gui/$CONSOLE_UID/$BUNDLE_ID" 2>/dev/null || true
fi
if [ -n "$USER_HOME" ]; then
    /bin/rm -f "$USER_HOME/Library/LaunchAgents/$BUNDLE_ID.plist"
fi

# Remove driver, app, and shared memory.
/bin/rm -rf "$DRIVER"
/bin/rm -rf "$APP"
/bin/rm -f "/tmp/soundbridge_ring_v1"
/bin/rm -f "/tmp/soundbridge-unregister.log"

# Remove per-user preferences, logs and saved state.
if [ -n "$USER_HOME" ]; then
    /bin/rm -rf "$USER_HOME/Library/Logs/SoundBridge"
    /bin/rm -rf "$USER_HOME/Library/Saved Application State/$BUNDLE_ID.savedState"
    /bin/rm -rf "$USER_HOME/Library/Caches/$BUNDLE_ID"
    /bin/rm -f "$USER_HOME/Library/Preferences/$BUNDLE_ID.plist"
    /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" \
        /usr/bin/defaults delete "$BUNDLE_ID" 2>/dev/null || true
fi

# Remove the uninstaller marker payload.
/bin/rm -f "/private/tmp/.soundbridge-uninstall-marker"

# Restart audio and refresh Launchpad/Dock.
/usr/bin/killall coreaudiod 2>/dev/null || true
/usr/bin/killall Dock 2>/dev/null || true

exit 0
